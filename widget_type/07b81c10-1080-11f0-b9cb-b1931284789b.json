      "templateHtml" : "<div class=\"bg-white rounded-lg shadow p-4 flex flex-col sm:flex-row gap-6 text-sm font-medium text-gray-800 w-full max-w-7xl mx-auto\">\n\n  <!-- Device Image & Header -->\n  <div class=\"flex flex-col items-center sm:w-1/5 text-center\">\n    <img src=\"https://i.imgur.com/dSDW0Sc.png\" alt=\"Device\" class=\"w-32 h-auto mb-2 opacity-90\" />\n    <div class=\"text-gray-600 text-xs\">✏️ Matthias Test Kiel</div>\n    <div class=\"text-xl font-bold text-gray-900\">RUT200</div>\n    <span class=\"bg-green-100 text-green-700 text-xs font-semibold px-3 py-1 rounded-full mt-2\">Online</span>\n\n    <!-- Action Icons -->\n    <div class=\"flex gap-2 mt-3\">\n      <button class=\"bg-gray-100 hover:bg-gray-200 p-1.5 rounded\"><i class=\"fas fa-sliders-h\"></i></button>\n      <button class=\"bg-gray-100 hover:bg-gray-200 p-1.5 rounded\"><i class=\"fas fa-terminal\"></i></button>\n      <button class=\"bg-gray-100 hover:bg-gray-200 p-1.5 rounded\"><i class=\"fas fa-sync-alt\"></i></button>\n    </div>\n  </div>\n\n  <!-- Horizontal Info Grid -->\n  <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 flex-1 text-sm\">\n    \n    <div><span class=\"text-gray-500\">Serial</span><br>6001176290</div>\n    <div><span class=\"text-gray-500\">Mobile status</span><br><span class=\"text-blue-600 font-bold\">📶 1</span></div>\n    \n    <div><span class=\"text-gray-500\">MAC Address</span><br>20:97:27:1E:E6:4B</div>\n    <div><span class=\"text-gray-500\">Ethernet ports</span><br><span class=\"bg-gray-200 text-gray-800 px-2 py-0.5 rounded text-xs\">1</span> <span class=\"bg-green-100 text-green-700 px-2 py-0.5 rounded text-xs\">W</span></div>\n    \n    <div><span class=\"text-gray-500\">IMEI</span><br>863553069804411</div>\n    <div><span class=\"text-gray-500\">Connection type</span><br><span class=\"bg-blue-100 text-blue-700 px-2 py-0.5 rounded text-xs\">Mobile (4G)</span></div>\n    \n    <div><span class=\"text-gray-500\">Firmware</span><br>RUT2M_R_00.07.13.2</div>\n    <div><span class=\"text-gray-500\">IP Address</span><br>10.135.0.4/32</div>\n    \n    <div><span class=\"text-gray-500\">Management service</span><br><span class=\"bg-green-100 text-green-700 px-2 py-0.5 rounded text-xs\">Active</span></div>\n    <div><span class=\"text-gray-500\">Monitoring templates</span><br><span class=\"bg-green-200 text-green-800 px-2 py-0.5 rounded text-xs\">2 / 7</span></div>\n\n    <div>\n      <span class=\"text-gray-500\">Device uptime</span><br>3d 20h 8min 33s\n    </div>\n    \n    <div>\n      <span class=\"text-gray-500\">CPU usage</span>\n      <div class=\"w-full bg-gray-200 rounded h-2 mt-1\">\n        <div class=\"bg-blue-500 h-2 rounded w-[5%]\"></div>\n      </div>\n      <span class=\"text-xs\">5.00%</span>\n    </div>\n\n    <div>\n      <span class=\"text-gray-500\">RAM usage</span>\n      <div class=\"w-full bg-gray-200 rounded h-2 mt-1\">\n        <div class=\"bg-blue-500 h-2 rounded w-[43%]\"></div>\n      </div>\n      <span class=\"text-xs\">54.06 / 126 MB</span>\n    </div>\n\n    <div>\n      <span class=\"text-gray-500\">Flash usage</span>\n      <div class=\"w-full bg-gray-200 rounded h-2 mt-1\">\n        <div class=\"bg-blue-500 h-2 rounded w-[32%]\"></div>\n      </div>\n      <span class=\"text-xs\">1.28 / 4 MB</span>\n    </div>\n\n    <div>\n      <span class=\"text-gray-500\">Temperature</span>\n      <div class=\"w-full bg-gray-200 rounded h-2 mt-1\">\n        <div class=\"bg-blue-500 h-2 rounded w-[33%]\"></div>\n      </div>\n      <span class=\"text-xs\">33 °C</span>\n    </div>\n\n    <div><span class=\"text-gray-500\">Modem</span><br>Quectel EC200A-EU</div>\n  </div>\n</div>\n",
