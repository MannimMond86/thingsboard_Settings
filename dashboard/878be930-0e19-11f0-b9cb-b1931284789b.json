            },
            "showTitle" : false,
            "backgroundColor" : "rgb(255, 255, 255)",
            "color" : "rgba(0, 0, 0, 0.87)",
            "padding" : "8px",
            "settings" : {
              "cardHtml" : "<div id=\"tbWidget\">\n  <style>\n    /* ==== Embedded CSS (Optimized for ThingsBoard) ==== */\n    :root {\n      --gradient: conic-gradient(\n        from 240deg at 50% 50%,\n        #00ffc3, #00fad9, #00f4f0, #00eeff, #00e6ff,\n        #00dcff, #00d2ff, #00c5ff, #00b8ff, #6da8ff,\n        #9f97ff, #c285ff\n      );\n    }\n\n    * { box-sizing: border-box; font-family: Arial, sans-serif; }\n    body, html, #tbWidget { margin: 0; padding: 0; background: black; color: white; }\n    #tbWidget { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }\n\n    input { display: none; }\n\n    #welcomeMessage {\n      font-size: 120%;\n      position: relative;\n    }\n\n    #welcomeMessage figcaption, h1, b {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n    }\n\n    #welcomeMessage figcaption::after {\n      content: \"\";\n      position: absolute;\n      background: var(--gradient);\n      width: 100%;\n      height: 100%;\n      z-index: -1;\n      top: 0;\n      left: 0;\n      opacity: 0.15;\n      border-radius: 10px;\n    }\n\n    h1 {\n      background: #333;\n      padding: 1em;\n      border-radius: 0.5em;\n      display: flex;\n      flex-direction: row;\n      gap: 0.5em;\n    }\n\n    b {\n      background: #555;\n      width: 2.5em;\n      height: 2.5em;\n      border-radius: 0.3em;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 1.2em;\n      cursor: pointer;\n      transition: transform 0.3s ease;\n    }\n\n    b:hover {\n      transform: scale(1.1);\n      background: #777;\n    }\n\n    .data-value {\n      margin-top: 1em;\n      color: #00ffc3;\n      font-size: 1.2em;\n    }\n  </style>\n\n  <!-- === UI HTML === -->\n  <input type=\"radio\" name=\"toggle\" id=\"toggleOpen\" value=\"toggleOpen\">\n  <input type=\"radio\" name=\"toggle\" id=\"toggleClose\" value=\"toggleClose\">\n\n  <figure id=\"welcomeMessage\">\n    <figcaption>\n      <h1>\n        <b>w</b><b>e</b><b>l</b><b>c</b><b>o</b><b>m</b><b>e</b>\n      </h1>\n      <div class=\"data-value\" id=\"apiValue\">Waiting for data...</div>\n    </figcaption>\n  </figure>\n\n  <!-- === Script for ThingsBoard Data API === -->\n  <script>\n    self.onInit = function() {\n      console.log(\"👾 Widget initialized\");\n\n      // Optional: Initial Setup\n    };\n\n    self.onDataUpdated = function() {\n      const dataSet = self.ctx.defaultSubscription?.data || [];\n\n      if (dataSet.length > 0) {\n        const lastKey = dataSet[0].data.slice(-1)[0]; // Get the latest value\n        const value = lastKey?.[1] ?? \"N/A\";\n\n        document.getElementById(\"apiValue\").innerText = \"Latest: \" + value;\n        console.log(\"📡 Data updated:\", value);\n      } else {\n        document.getElementById(\"apiValue\").innerText = \"No data\";\n      }\n    };\n  </script>\n</div>\n",
              "cardCss" : ".card {\n    font-weight: bold;\n    font-size: 32px;\n    color: #999;\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n}"
